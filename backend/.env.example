PORT=6767
# development | production. Production refuses to start with unsafe settings.
NODE_ENV=development
# Secret used to sign session tokens. Required in production (32+ random chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Google OAuth client ID (same one as the frontend's VITE_GOOGLE_CLIENT_ID). Google login is off without it.
GOOGLE_CLIENT_ID=
# Society reps: comma-separated email:societyId pairs
ADMIN_EMAILS=lead@kiit.ac.in:soc_krs
# Email-only demo login. Defaults to on in development, off in production.
# ALLOW_DEV_LOGIN=true
# Campus timezone used for "today" (default Asia/Kolkata)
# TZ=Asia/Kolkata
# Where the SQLite file and uploaded banners live (point at a persistent disk when deployed)
# DB_PATH=./data/eventsphere.db
# UPLOAD_DIR=./data/uploads
# Optional: fixed VAPID keys for Web Push (generated and stored in the DB if empty)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:eventsphere@kiit.ac.in
