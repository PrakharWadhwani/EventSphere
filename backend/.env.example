PORT=6767
# Secret used to sign session tokens. Change this in production.
JWT_SECRET=change-me
# Google OAuth client ID (same one as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Society reps: comma-separated email:societyId pairs
ADMIN_EMAILS=lead@kiit.ac.in:soc_krs
# Email-only login for demos. Set to false in production.
ALLOW_DEV_LOGIN=true
# Optional: fixed VAPID keys for Web Push (generated automatically if empty)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:eventsphere@kiit.ac.in
